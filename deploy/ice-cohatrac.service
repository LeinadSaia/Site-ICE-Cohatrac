[Unit]
Description=Servico Web Next.js - Igreja Crista Evangelica em Cohatrac (ICE Cohatrac)
Documentation=https://github.com/LeinadSaia/Site-ICE-Cohatrac
After=network.target

[Service]
Type=simple
User=leinad
WorkingDirectory=/home/leinad/Documentos/Site ICE Cohatrac
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/home/leinad/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/leinad/.nvm/versions/node/v24.20.0/bin/npm run start
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ice-cohatrac

[Install]
WantedBy=multi-user.target
